# Niriksh AI Backend — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase project credentials. No queries use these yet (see
# app/utils/supabase_client.py) — every service returns mocked data
# until Maithrayi wires up the real tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sarvam AI — powers GET /api/investigation/active (see
# app/services/sarvam_service.py) AND the voice copilot's
# POST /api/speech/transcribe + /api/speech/speak (see
# app/services/speech_service.py) — one key covers Sarvam's chat and
# speech APIs both. Get a key from https://dashboard.sarvam.ai. Left
# blank, investigations fall back to a mocked one and the speech endpoints
# return 502 (the frontend falls back to typed text) — neither errors out
# to the merchant.
SARVAM_API_KEY=

# Cognee — powers GET /api/memory/timeline and the historical context fed
# into Sarvam (see app/services/cognee_service.py). Get a key from
# https://docs.cognee.ai/cognee-cloud/ui/api-keys. Left blank, memory falls
# back to a local mocked history for merchant M102 — no error.
COGNEE_API_KEY=

# n8n — triggers the merchant-approved recovery workflow (see
# app/services/n8n_service.py). Point this at an n8n Webhook node's
# Production URL. Left blank, POST /api/workflow/run still works — the
# webhook call is skipped and progress is simulated locally end to end.
N8N_WEBHOOK_URL=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
